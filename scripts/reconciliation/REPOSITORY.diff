-+"""
-+templates.py
-+
-+Repository template resolution services.
-+"""
-+
-+from pathlib import Path
-+
-+# Repository-relative template directory
-+TEMPLATE_DIRECTORY = Path("../Templates")
-+
-+# Template lookup table
-+TEMPLATES = {
-+    "GOV": "GOV.template.md",
-+    "ARC": "ARC.template.md",
-+    "ADR": "ADR.template.md",
-+    "SPEC": "SPEC.template.md",
-+    "PUB": "PUB.template.md",
-+}
-+
-+
-+def get_template(document_type: str) -> Path:
-+    """
-+    Return the template path for a document type.
-+
-+    Raises:
-+        KeyError if the document type is unknown.
-+    """
-+    filename = TEMPLATES[document_type.upper()]
-+    return TEMPLATE_DIRECTORY / filename
