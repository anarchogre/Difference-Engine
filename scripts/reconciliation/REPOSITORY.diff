+"""
+ids.py
+
+Repository document identifier services.
+"""
+
+import re
+from pathlib import Path
+
+
+ID_PATTERN = re.compile(r"([A-Z]+)-(\d{4})")
+
+
+def parse_document_id(filename: str):
+    """
+    Extract document type and numeric ID from a filename.
+
+    Returns:
+        (document_type, number)
+
+    Raises:
+        ValueError if no valid ID exists.
+    """
+
+    match = ID_PATTERN.search(filename)
+
+    if not match:
+        raise ValueError(f"No document ID found: {filename}")
+
+    return match.group(1), int(match.group(2))
